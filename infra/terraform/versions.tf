terraform {
  required_version = ">= 1.6"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# La suscripción llega por la variable de entorno ARM_SUBSCRIPTION_ID.
provider "azurerm" {
  features {}
}
